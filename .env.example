# API 端口（默认 5180）
API_PORT=5180

# 可选：聚合数据联行号全量接口
# JUHE_INTERBANK_KEY=

# 运营后台令牌（页面访问统计 /admin，请求头 X-Admin-Token）
# ADMIN_TOKEN=change-me-to-a-long-secret

# CORS（默认 *）
# CORS_ORIGINS=http://localhost:5176

# Web 开发代理目标（apps/web vite）
# VITE_API_PROXY_TARGET=http://127.0.0.1:5180

# 客服微信（批量页展示，用户据此索要激活码）
CS_WECHAT=your_wechat_id
# CS_TIP=添加微信客服，说明批量查询需求，核实后发放激活码解锁

# 免费单条查询每日次数（按 IP）
# FREE_SINGLE_DAILY=30
# 批量查询单次最多行数
# BATCH_MAX_LINES=200

# 临沂公共数据开放网 · 公交 GPS（用户中心「我的令牌」）
# 鉴权：X-Client-Id + X-Timestamp + X-Nonce + X-Signature(HmacSHA256)
# 申请说明见 docs/临沂开放数据-公交GPS.md
# LYDATA_CLIENT_ID=
# LYDATA_CLIENT_SECRET=
# LYDATA_BUS_CACHE_MS=20000
# LYDATA_BUS_PAGE_SIZE=100
# LYDATA_BUS_MAX_FETCH=500
# LYDATA_BUS_GATEWAY=http://lydata.sd.gov.cn/gateway/api/1/gjcGPSjzdsjxx
# 未配 LYDATA_* 时会回退使用下方 SD_OPEN_CLIENT_*（须已申请本接口）

# 高德 Web 服务 Key（本地银行网点地图地理编码，控制台开「Web服务」）
# https://console.amap.com/dev/key/app
# AMAP_WEB_KEY=
# AMAP_WEB_SECRET=
# 批量：npm run geocode:linyi-banks
# 脱敏地址补全：npm run enrich:places -- training|freight|ss-card|passenger|driving

# ɽ���������ݿ���������������/��ˮ�� �� ǩ�����ƣ�
# SD_OPEN_CLIENT_ID=
# SD_OPEN_CLIENT_SECRET=

